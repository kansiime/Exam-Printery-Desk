# Copy to .env and fill in. Never commit .env.

# Your printery's name: shown in the app and in SMS to schools
BUSINESS_NAME=Exam Printery

# Django
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=printery.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://printery.example.com
DJANGO_SECURE_COOKIES=1

# Database
POSTGRES_DB=printery
POSTGRES_USER=printery
POSTGRES_PASSWORD=change-me

# SMS (Africa's Talking). Leave SMS_PROVIDER=console to only log messages.
SMS_PROVIDER=console
AT_USERNAME=sandbox
AT_API_KEY=
AT_SENDER_ID=
OWNER_PHONE=07XXXXXXXX
SUMMARY_HOUR=20
SUMMARY_MINUTE=37

# Shared secrets that webhook callers must send (header X-Webhook-Token or ?token=)
SMS_WEBHOOK_TOKEN=change-me
MOMO_WEBHOOK_TOKEN=change-me
